---
const capabilities = [
  {
    icon: "🎬",
    title: "Video Editing (CapCut & Premiere Pro)",
    badge: "Video Post-Production",
    description: "I take raw footage and edit short-form CapCut video reels for Instagram & TikTok (with captions, cuts, and sound effects), plus full Premiere Pro video ad edits for Meta and YouTube.",
    deliverables: [
      "CapCut Short Reels with Auto-Captions & Sound Effects",
      "Premiere Pro Video Ads with Motion Graphics",
      "Format Conversions for TikTok, Reels & YouTube Shorts",
      "Promo Video Banners for E-Commerce Campaigns"
    ]
  },
  {
    icon: "🎯",
    title: "Paid Ad Campaigns (Google & Meta Ads)",
    badge: "Performance Ads",
    description: "I set up and manage paid ad campaigns from scratch—writing ad copy, building audience segments, setting up Meta Pixels & Google Conversion tracking, and optimizing budget pacing.",
    deliverables: [
      "Google Search & Performance Max Campaign Setup",
      "Meta Ads (Facebook/Instagram) Audience Targeting",
      "Pixel & GA4 Conversion Event Tracking",
      "A/B Testing Ad Copy & Visual Creatives"
    ]
  },
  {
    icon: "🛒",
    title: "E-Commerce Catalog Sync (Noon & Carrefour)",
    badge: "Store Operations",
    description: "I manage Shopify and Magento online stores, update product descriptions, set up price rules, and synchronize your catalog live across regional marketplaces like Noon and Carrefour.",
    deliverables: [
      "Shopify & Magento Store Product Listings",
      "Live Catalog & Inventory Sync on Noon & Carrefour",
      "ElGrocer & InstaShop Product Updates",
      "Promo Banner Launches & Checkout Flow Fixes"
    ]
  },
  {
    icon: "🤖",
    title: "AI Automation Scripts & Python Tools",
    badge: "Python & Local LLMs",
    description: "I write custom Python scripts using local AI models (DeepSeek R1 & Ollama) to clean messy spreadsheets, parse server log files during outages, and automate repetitive tasks.",
    deliverables: [
      "Python Data Cleaning & Formatting Scripts",
      "Local DeepSeek & Ollama Workflow Pipelines",
      "Server Log Parsing & Outage Triage Scripts",
      "Automated Excel / CSV Data Processing"
    ]
  },
  {
    icon: "⚡",
    title: "Fast Web Apps & GA4 Technical SEO",
    badge: "Web Infrastructure",
    description: "I build ultra-fast, modern websites using Astro and Next.js that load in milliseconds and score 100/100 on Google Lighthouse, complete with GA4 tracking and Search Console indexing.",
    deliverables: [
      "Ultra-Fast Astro / Next.js Web App Builds",
      "Google Analytics 4 & Search Console Setup",
      "IndexNow Protocol Instant Search Indexing",
      "DNS, SSL & Subdomain Hosting Setup"
    ]
  }
];
---

<section id="capabilities" class="py-24 px-4 sm:px-6 lg:px-8 relative">
  <div class="mx-auto max-w-5xl space-y-16">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-50 dark:bg-indigo-500/10 px-4 py-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300 shadow-sm">
        🛠️ Practical Capabilities & Real Work
      </span>
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Here is exactly <span class="gradient-text">what I build and manage</span>
      </h2>
      <p class="text-base text-slate-600 dark:text-gray-400 leading-relaxed font-medium">
        No vague buzzwords or soulless logo carousels. I don't put out fake fluff—I build the actual modern, high-performing, practical work you'll love:
      </p>
    </div>

    <!-- Elaborate Capability Cards Grid -->
    <div class="space-y-8">
      {capabilities.map((cap) => (
        <div class="glass-card spotlight-card rounded-3xl p-8 border border-slate-200 dark:border-gray-800">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-4">
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 dark:bg-gray-900 border border-indigo-200 dark:border-gray-700 text-3xl shadow-sm">
                {cap.icon}
              </div>
              <div>
                <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">{cap.badge}</span>
                <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">{cap.title}</h3>
              </div>
            </div>
          </div>

          <p class="text-sm text-slate-700 dark:text-gray-300 leading-relaxed mb-6 font-medium">
            {cap.description}
          </p>

          <div class="pt-6 border-t border-slate-200 dark:border-gray-800">
            <div class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Concrete Deliverables:</div>
            <div class="grid sm:grid-cols-2 gap-3">
              {cap.deliverables.map((d) => (
                <div class="flex items-center gap-2.5 text-xs font-medium text-slate-700 dark:text-gray-300">
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
                  <span>{d}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
