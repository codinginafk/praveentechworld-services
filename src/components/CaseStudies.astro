---
const caseStudies = [
  {
    tag: "Custom E-Commerce Storefront",
    title: "NatureNestGifts Full Setup & Handcrafted Candle E-Com Build",
    client: "NatureNestGifts",
    link: "https://NatureNestGifts.vercel.app",
    linkText: "Launch Live Site ↗",
    icon: "🕯️",
    badge: "Independent E-Com Build",
    description: "Designed and built an independent handcrafted candle e-commerce website from the ground up. Handled platform architecture, UI layouts, graphic banners, product mockups, and end-to-end digital marketing.",
    highlights: ["Brand Creation", "Independent E-Com Setup", "Product Graphics", "Digital Marketing"]
  },
  {
    tag: "Content Hub & Environmental Media",
    title: "TheSocialTraveller Media Platform & Documentary Action Portal",
    client: "TheSocialTraveller",
    link: "https://thesocialtraveller-demo.vercel.app",
    linkText: "Launch Live Site ↗",
    icon: "🌍",
    badge: "Scenic Travel & Environmental Action",
    description: "Designed an interactive documentary portal showcasing travel logs and environmental cleanup campaigns with structured map indexers, high-resolution media galleries, and video embeds.",
    highlights: ["Next.js & Tailwind", "Video Integration", "Map Indexers", "Media Platform"]
  },
  {
    tag: "AI & Tech Knowledge Engine",
    title: "PTW Content Engine, GA4 & Technical SEO Infrastructure",
    client: "PraveenTechWorld",
    link: "https://www.praveentechworld.com",
    linkText: "Explore Tech Portal ↗",
    icon: "🤖",
    badge: "Founder & Content Engine Builder",
    description: "Built and self-manage a personal technology knowledge base (389 static HTML pages). Configured automated IndexNow search triggers, Google Analytics 4 tracking, Search Console indexers, and SVG graphic assets.",
    highlights: ["Astro & Tailwind", "Automated SEO Pipelines", "IndexNow Trigger", "GA4 Event Tracking"]
  },
  {
    tag: "Multi-Channel Retail E-Commerce",
    title: "35+ Retail Branches Magento/Shopify & Marketplace Sync",
    client: "Adil Supermarket E-Commerce",
    link: "https://adilstore.com",
    linkText: "Visit E-Com Platform ↗",
    icon: "🛒",
    badge: "Noon & Carrefour Marketplace Sync",
    description: "Managed live e-commerce catalog operations, price rules, and promo banners across primary Magento/Shopify stores while maintaining real-time stock sync on Noon, Carrefour, ElGrocer, and InstaShop.",
    highlights: ["Shopify & Magento", "Noon & Carrefour", "ElGrocer & InstaShop", "Power BI Dashboards"]
  }
];
---

<section id="case-studies" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-slate-100/60 dark:bg-gray-950/40 scroll-reveal">
  <div class="mx-auto max-w-7xl">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-50 dark:bg-emerald-500/10 px-4 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 shadow-sm">
        💼 Live Platforms & Real-World Projects
      </span>
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Featured <span class="gradient-text">Platforms & Live Projects</span>
      </h2>
      <p class="text-base text-slate-600 dark:text-gray-400 leading-relaxed font-medium">
        Explore live independent e-commerce storefronts, environmental content hubs, retail networks, and AI knowledge engines built from the ground up:
      </p>
    </div>

    <!-- Case Studies Cards Grid with Inspira 3D Tilt & Animate UI Border Beam -->
    <div class="grid gap-8 md:grid-cols-2">
      {caseStudies.map((cs) => (
        <div class="glass-card spotlight-card tilt-card border-beam rounded-3xl p-8 flex flex-col justify-between border border-slate-200 dark:border-gray-800/80 hover:border-indigo-500/50 transition-all scroll-reveal">
          <div>
            <!-- Header Badges -->
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
              <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400 tracking-wider uppercase">
                {cs.tag}
              </span>
              <span class="rounded-full bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-500/30 px-3 py-1 text-[11px] font-bold text-emerald-700 dark:text-emerald-300">
                {cs.badge}
              </span>
            </div>

            <!-- Icon & Title -->
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl p-2 rounded-2xl bg-indigo-50 dark:bg-gray-900 border border-indigo-100 dark:border-gray-800">{cs.icon}</span>
              <div>
                <h3 class="text-xl font-extrabold text-slate-900 dark:text-white leading-snug">
                  {cs.title}
                </h3>
                <div class="text-xs font-semibold text-slate-500 dark:text-gray-400 mt-0.5">
                  🏢 {cs.client}
                </div>
              </div>
            </div>

            <!-- Description -->
            <p class="text-sm text-slate-600 dark:text-gray-300 leading-relaxed mb-6 font-medium">
              {cs.description}
            </p>
          </div>

          <!-- Footer Tech Chips & Live Launch Link -->
          <div class="pt-6 border-t border-slate-200 dark:border-gray-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex flex-wrap gap-1.5">
              {cs.highlights.map((h) => (
                <span class="rounded-lg bg-slate-100 dark:bg-gray-800/80 px-2.5 py-1 text-[11px] font-bold text-slate-700 dark:text-gray-300 border border-slate-200 dark:border-gray-700/50">
                  {h}
                </span>
              ))}
            </div>

            <a href={cs.link} target="_blank" class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-indigo-600 to-cyan-500 px-4 py-2.5 text-xs font-bold text-white shadow-md hover:scale-105 transition-all shrink-0">
              {cs.linkText}
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
