---
const caseStudies = [
  {
    tag: "E-Commerce & Retail",
    title: "Multi-Channel Retail Marketplace Integration & Web Store Management",
    client: "Adil Supermarket E-Commerce (adilstore.com & bh.adilstore.com)",
    impact: "+100% Marketplace Sync",
    description: "Managed live e-commerce catalog operations, price rule updates, and promotional banner campaigns across primary Magento/Shopify stores while maintaining real-time inventory sync on Noon, Carrefour, ElGrocer, and InstaShop.",
    highlights: ["Shopify & Magento", "Noon & Carrefour", "ElGrocer & InstaShop", "Catalog Operations"]
  },
  {
    tag: "AI & Cloud Automation",
    title: "Local LLM Infrastructure & Incident Triage Automation",
    client: "Internal Engineering Workbench",
    impact: "-60% API Expense",
    description: "Built custom Python automation scripts powered by DeepSeek and Ollama to parse network schematics, automate database audits, and triage server outage logs completely offline, eliminating cloud telemetry risks.",
    highlights: ["DeepSeek R1", "Qwen 3.6 VLM", "Python Automation", "Ollama CLI"]
  },
  {
    tag: "Technical SEO & Edge Web",
    title: "90+ Article Knowledge Base with Real-Time IndexNow Pipeline",
    client: "PraveenTechWorld (praveentechworld.com)",
    impact: "389 Pages Indexed",
    description: "Engineered a high-performance Astro technical publication from scratch. Configured GA4 event tracking, Google Search Console, and automated IndexNow protocol triggers that broadcast content updates instantly to Bing and search crawlers.",
    highlights: ["Astro Framework", "IndexNow Protocol", "GA4 Analytics", "Pagefind Search"]
  }
];
---

<section id="case-studies" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-gray-950/40">
  <div class="mx-auto max-w-7xl">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 text-xs font-bold text-emerald-300">
        💼 Proven Project Execution & Impact
      </span>
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        Real-World <span class="gradient-text">Case Studies & Impact</span>
      </h2>
      <p class="text-base text-gray-400 leading-relaxed">
        A look at live platforms, e-commerce networks, and technical automation tools built and operated on our engineering workbench.
      </p>
    </div>

    <!-- Case Studies Cards Grid -->
    <div class="grid gap-8 lg:grid-cols-3">
      {caseStudies.map((cs) => (
        <div class="glass-card rounded-3xl p-8 flex flex-col justify-between border border-gray-800/80 hover:border-emerald-500/40 transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-emerald-400 tracking-wider uppercase">
                {cs.tag}
              </span>
              <span class="rounded-full bg-emerald-500/10 border border-emerald-500/30 px-3 py-1 text-xs font-bold text-emerald-300">
                {cs.impact}
              </span>
            </div>

            <h3 class="text-xl font-extrabold text-white mb-2 leading-snug">
              {cs.title}
            </h3>

            <div class="text-xs font-semibold text-gray-400 mb-4">
              📍 {cs.client}
            </div>

            <p class="text-sm text-gray-300 leading-relaxed mb-6">
              {cs.description}
            </p>
          </div>

          <div class="flex flex-wrap gap-2 pt-4 border-t border-gray-800/80">
            {cs.highlights.map((h) => (
              <span class="rounded-lg bg-gray-800/80 px-2.5 py-1 text-[11px] font-semibold text-gray-300 border border-gray-700/50">
                {h}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
