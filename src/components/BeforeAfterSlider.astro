---
---

<section class="py-24 px-4 sm:px-6 lg:px-8 relative scroll-reveal">
  <div class="mx-auto max-w-5xl space-y-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-50 dark:bg-cyan-500/10 px-4 py-1.5 text-xs font-bold text-cyan-700 dark:text-cyan-300 shadow-sm">
        🎛️ Animate UI Visual Comparison
      </span>
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Before vs After <span class="gradient-text">Transformation</span>
      </h2>
      <p class="text-base text-slate-600 dark:text-gray-400 leading-relaxed font-medium">
        See how manual repetitive headaches transform into automated, high-performing systems.
      </p>
    </div>

    <!-- Interactive Comparison Cards -->
    <div class="grid md:grid-cols-2 gap-8">
      
      <!-- Comparison 1: Spreadsheet Data Cleaning -->
      <div class="glass-card spotlight-card rounded-3xl p-8 border border-slate-200 dark:border-gray-800 space-y-6">
        <div class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">Transformation 01 • Python Data Automation</div>
        
        <div class="grid grid-cols-2 gap-4">
          <!-- Before -->
          <div class="p-4 rounded-2xl bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-800/40 space-y-2">
            <span class="text-[11px] font-bold text-red-700 dark:text-red-400 uppercase">❌ BEFORE (Manual Excel)</span>
            <ul class="space-y-1 text-xs text-slate-700 dark:text-gray-300">
              <li>• 3+ hours manual copying</li>
              <li>• Formatting errors & typos</li>
              <li>• Broken CSV headers</li>
              <li>• Repeated daily burnout</li>
            </ul>
          </div>

          <!-- After -->
          <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 space-y-2">
            <span class="text-[11px] font-bold text-emerald-700 dark:text-emerald-400 uppercase">✅ AFTER (Python Script)</span>
            <ul class="space-y-1 text-xs text-slate-700 dark:text-gray-300">
              <li>• 1-Click Python execution</li>
              <li>• 100% clean & validated</li>
              <li>• Takes 4 seconds to run</li>
              <li>• Zero manual effort</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Comparison 2: Page Speed & Performance -->
      <div class="glass-card spotlight-card rounded-3xl p-8 border border-slate-200 dark:border-gray-800 space-y-6">
        <div class="text-xs font-mono font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider">Transformation 02 • Astro Edge Web Apps</div>
        
        <div class="grid grid-cols-2 gap-4">
          <!-- Before -->
          <div class="p-4 rounded-2xl bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-800/40 space-y-2">
            <span class="text-[11px] font-bold text-red-700 dark:text-red-400 uppercase">❌ BEFORE (Slow Site)</span>
            <ul class="space-y-1 text-xs text-slate-700 dark:text-gray-300">
              <li>• 3.2s slow page load</li>
              <li>• Failed Core Web Vitals</li>
              <li>• High bounce rate</li>
              <li>• Crawl indexing delays</li>
            </ul>
          </div>

          <!-- After -->
          <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 space-y-2">
            <span class="text-[11px] font-bold text-emerald-700 dark:text-emerald-400 uppercase">✅ AFTER (Astro Build)</span>
            <ul class="space-y-1 text-xs text-slate-700 dark:text-gray-300">
              <li>• 0.1s sub-second speed</li>
              <li>• 100/100 Lighthouse score</li>
              <li>• Instant user response</li>
              <li>• Instant IndexNow pings</li>
            </ul>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
