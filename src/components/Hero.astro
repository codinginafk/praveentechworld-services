---
---

<section class="relative pt-32 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Ambient Glow Backgrounds -->
  <div class="ambient-glow animate-pulse-glow -top-24 -right-24 h-96 w-96 bg-indigo-500/15"></div>
  <div class="ambient-glow animate-pulse-glow top-1/2 -left-24 h-96 w-96 bg-cyan-500/15"></div>
  <div class="ambient-glow animate-pulse-glow -bottom-24 right-1/3 h-96 w-96 bg-emerald-500/15"></div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      
      <!-- Main Bio & Taglines -->
      <div class="space-y-6 lg:col-span-7">
        <!-- Status Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-50 dark:bg-emerald-500/10 px-4 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            Immediate Joiner • Dubai, UAE
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-indigo-500/30 bg-indigo-50 dark:bg-indigo-500/10 px-4 py-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300 shadow-sm">
            🇦🇪 Valid UAE Residence Visa
          </span>
        </div>

        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-6xl lg:text-6xl leading-[1.1]">
          Digital Marketing, <br />
          <span class="gradient-text">AI Automation & Web Ops</span>
        </h1>

        <p class="text-lg text-slate-600 dark:text-gray-300 leading-relaxed max-w-2xl font-medium">
          Hi, I’m <strong class="text-slate-900 dark:text-white">Praveen Kumar Mishra</strong>. I help brands scale paid advertising (Google & Meta Ads), automate repetitive workflows using AI models (DeepSeek & ChatGPT), optimize live e-commerce stores (Noon, Carrefour), and build high-performance web architecture.
        </p>

        <!-- CTA Action Cluster -->
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a href="#services" class="inline-flex items-center gap-2 rounded-2xl bg-gradient-to-r from-indigo-600 via-cyan-500 to-emerald-400 p-0.5 shadow-xl shadow-indigo-600/20 hover:scale-[1.02] active:scale-[0.98] transition-all">
            <span class="rounded-[14px] bg-white dark:bg-[#090d16] px-6 py-3.5 text-sm font-bold text-slate-900 dark:text-white hover:bg-transparent hover:text-white transition-colors">
              Explore Services & Packages ⚡
            </span>
          </a>
          <a href="https://www.linkedin.com/in/praveen-kumar-says/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-2xl border border-slate-300 dark:border-gray-700 bg-white dark:bg-gray-900/60 px-6 py-3.5 text-sm font-bold text-slate-800 dark:text-gray-200 shadow-sm hover:border-indigo-600 dark:hover:border-indigo-500 transition-all">
            <svg class="h-4 w-4 fill-current text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8z"/></svg>
            LinkedIn Profile
          </a>
        </div>

        <!-- Quick Contacts -->
        <div class="flex flex-wrap gap-4 pt-2 text-xs font-mono text-slate-500 dark:text-gray-400 font-medium">
          <span class="flex items-center gap-1.5">📍 Dubai, UAE (Open to Ajman & Remote)</span>
          <span class="flex items-center gap-1.5">✉️ MishratWork@gmail.com</span>
        </div>
      </div>

      <!-- Hero Metric Cards Grid -->
      <div class="lg:col-span-5">
        <div class="grid gap-4 sm:grid-cols-2">

          <div class="glass-card spotlight-card rounded-3xl p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-2xl mb-4">
              🎯
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">Full-Funnel</div>
            <div class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 mt-1">Paid Ads & Performance</div>
            <p class="text-xs text-slate-500 dark:text-gray-400 mt-2 leading-relaxed">
              Google Ads, Meta Ads, audience segmentation, and ROAS optimization.
            </p>
          </div>

          <div class="glass-card spotlight-card rounded-3xl p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-2xl mb-4">
              🤖
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">AI Driven</div>
            <div class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 mt-1">Workflow Automation</div>
            <p class="text-xs text-slate-500 dark:text-gray-400 mt-2 leading-relaxed">
              DeepSeek, Ollama, Python automation scripts & local LLM pipelines.
            </p>
          </div>

          <div class="glass-card spotlight-card rounded-3xl p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 text-2xl mb-4">
              🛒
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">E-Com Ops</div>
            <div class="text-sm font-semibold text-amber-600 dark:text-amber-400 mt-1">Marketplace Sync</div>
            <p class="text-xs text-slate-500 dark:text-gray-400 mt-2 leading-relaxed">
              Noon, Carrefour, ElGrocer, InstaShop & Magento/Shopify stores.
            </p>
          </div>

          <div class="glass-card spotlight-card rounded-3xl p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 text-2xl mb-4">
              📊
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">GA4 & SEO</div>
            <div class="text-sm font-semibold text-cyan-600 dark:text-cyan-400 mt-1">Data & Web Infrastructure</div>
            <p class="text-xs text-slate-500 dark:text-gray-400 mt-2 leading-relaxed">
              GA4 events, Search Console, Power BI, DNS/SSL & edge web apps.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
