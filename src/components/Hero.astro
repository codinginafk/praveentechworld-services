<section class="relative pt-32 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Soft Ambient Background Glows -->
  <div class="ambient-glow animate-pulse-glow -top-24 -right-24 h-96 w-96 bg-indigo-500/10"></div>
  <div class="ambient-glow animate-pulse-glow top-1/2 -left-24 h-96 w-96 bg-emerald-500/10"></div>

  <div class="relative z-10 mx-auto max-w-4xl text-center space-y-8">
    
    <!-- Friendly Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/20 bg-indigo-50 dark:bg-indigo-500/10 px-4 py-2 text-xs font-bold text-indigo-700 dark:text-indigo-300 shadow-sm">
      ✨ 100% Free First Project — Test My Work Zero Risk
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-6xl lg:text-6xl leading-[1.15]">
      I’ll do your first project or audit <br />
      <span class="gradient-text">100% Free. Test my work first.</span>
    </h1>

    <!-- Conversational Subhead -->
    <p class="text-lg text-slate-600 dark:text-gray-300 leading-relaxed max-w-2xl mx-auto font-medium">
      Hi, I’m <strong class="text-slate-900 dark:text-white">Praveen Kumar Mishra</strong>. I'm building up my independent freelance portfolio. Instead of asking for money upfront, I’ll handle your first small project, ad audit, video edit, or script completely free. If you like the results, we can work together on future projects. If not, you keep the work and we part as friends.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
      <a href="#contact" class="inline-flex items-center gap-2 rounded-2xl bg-gradient-to-r from-indigo-600 via-cyan-500 to-emerald-500 p-0.5 shadow-xl shadow-indigo-600/20 hover:scale-[1.02] active:scale-[0.98] transition-all">
        <span class="rounded-[14px] bg-white dark:bg-[#090d16] px-8 py-4 text-base font-bold text-slate-900 dark:text-white hover:bg-transparent hover:text-white transition-colors">
          Claim Your Free First Project 🚀
        </span>
      </a>
      <a href="#capabilities" class="inline-flex items-center gap-2 rounded-2xl border border-slate-300 dark:border-gray-700 bg-white dark:bg-gray-900/60 px-6 py-4 text-sm font-bold text-slate-800 dark:text-gray-200 shadow-sm hover:border-indigo-600 transition-all">
        See What I Can Build For You ↓
      </a>
    </div>

    <!-- Friendly Guarantee Callout -->
    <div class="pt-4 max-w-xl mx-auto text-xs text-slate-500 dark:text-gray-400 font-medium border-t border-slate-200 dark:border-gray-800">
      💡 No credit card needed • No catches • If you aren't happy, I'll fix it or refund immediately.
    </div>

  </div>
</section>
