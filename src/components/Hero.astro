---
---

<section class="relative pt-32 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Ambient Glow Backgrounds -->
  <div class="ambient-glow animate-pulse-glow -top-24 -right-24 h-96 w-96 bg-indigo-500/15"></div>
  <div class="ambient-glow animate-pulse-glow top-1/2 -left-24 h-96 w-96 bg-cyan-500/15"></div>
  <div class="ambient-glow animate-pulse-glow -bottom-24 right-1/3 h-96 w-96 bg-emerald-500/15"></div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      
      <!-- Main Bio & Taglines -->
      <div class="space-y-6 lg:col-span-7">
        <!-- Launch Offer Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-50 dark:bg-indigo-500/10 px-4 py-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300 shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
            </span>
            🎁 Freelance Launch Deal: Up to 70% Off First Project!
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-50 dark:bg-emerald-500/10 px-4 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 shadow-sm">
            🛡️ 100% Money-Back Guarantee
          </span>
        </div>

        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-6xl lg:text-6xl leading-[1.1]">
          Digital Marketing, <br />
          <span class="gradient-text">AI Workflows & Web Ops</span>
        </h1>

        <p class="text-lg text-slate-600 dark:text-gray-300 leading-relaxed max-w-2xl font-medium">
          Hi, I’m <strong class="text-slate-900 dark:text-white">Praveen Kumar Mishra</strong>. I've spent years running Google and Meta ad campaigns, managing live retail e-commerce stores, and setting up automated AI pipelines. Now I'm taking on freelance clients, so you get top-tier work at up to <strong class="text-indigo-600 dark:text-indigo-400">70% off your first project</strong>. Need something specific built or fixed? Just let me know what you're working on.
        </p>

        <!-- CTA Action Cluster -->
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a href="#pricing" class="inline-flex items-center gap-2 rounded-2xl bg-gradient-to-r from-indigo-600 via-cyan-500 to-emerald-400 p-0.5 shadow-xl shadow-indigo-600/20 hover:scale-[1.02] active:scale-[0.98] transition-all">
            <span class="rounded-[14px] bg-white dark:bg-[#090d16] px-6 py-3.5 text-sm font-bold text-slate-900 dark:text-white hover:bg-transparent hover:text-white transition-colors">
              Check Freelance Deals (70% Off) ⚡
            </span>
          </a>
          <a href="#contact" class="inline-flex items-center gap-2 rounded-2xl border border-slate-300 dark:border-gray-700 bg-white dark:bg-gray-900/60 px-6 py-3.5 text-sm font-bold text-slate-800 dark:text-gray-200 shadow-sm hover:border-indigo-600 dark:hover:border-indigo-500 transition-all">
            💬 Request Anything Custom
          </a>
        </div>

        <!-- Risk-Free Callout -->
        <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-800/40 text-xs text-slate-700 dark:text-emerald-300 leading-relaxed font-medium max-w-xl">
          💡 <strong>My Personal Promise:</strong> If anything doesn't work out or you're not completely happy with the results, I'll refund your money immediately. No hassle, no hard feelings.
        </div>
      </div>

      <!-- Hero Metric Cards Grid -->
      <div class="lg:col-span-5">
        <div class="grid gap-4 sm:grid-cols-2">

          <div class="glass-card spotlight-card rounded-3xl p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-2xl mb-4">
              🎯
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">Paid Ads</div>
            <div class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 mt-1">Google & Meta Campaigns</div>
            <p class="text-xs text-slate-500 dark:text-gray-400 mt-2 leading-relaxed">
              Targeted ad setup, pixel tracking, and budget optimization for maximum returns.
            </p>
          </div>

          <div class="glass-card spotlight-card rounded-3xl p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-2xl mb-4">
              🤖
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">AI Scripts</div>
            <div class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 mt-1">Workflow Automation</div>
            <p class="text-xs text-slate-500 dark:text-gray-400 mt-2 leading-relaxed">
              DeepSeek, Ollama, and Python scripts to automate boring, manual tasks.
            </p>
          </div>

          <div class="glass-card spotlight-card rounded-3xl p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 text-2xl mb-4">
              🛒
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">E-Commerce</div>
            <div class="text-sm font-semibold text-amber-600 dark:text-amber-400 mt-1">Store & Catalog Ops</div>
            <p class="text-xs text-slate-500 dark:text-gray-400 mt-2 leading-relaxed">
              Shopify, Magento, and marketplace sync across Noon & Carrefour.
            </p>
          </div>

          <div class="glass-card spotlight-card rounded-3xl p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 text-2xl mb-4">
              📊
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">Analytics</div>
            <div class="text-sm font-semibold text-cyan-600 dark:text-cyan-400 mt-1">GA4 & Custom Sites</div>
            <p class="text-xs text-slate-500 dark:text-gray-400 mt-2 leading-relaxed">
              GA4 tracking, technical SEO, and fast custom websites built to convert.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
