<header class="glass-nav fixed top-0 left-0 right-0 z-50 py-4 px-4 sm:px-8">
  <div class="mx-auto flex max-w-7xl items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-indigo-600 via-cyan-500 to-emerald-400 p-0.5 shadow-lg shadow-indigo-500/20 group-hover:scale-105 transition-all">
        <div class="flex h-full w-full items-center justify-center rounded-[10px] bg-[#090d16]">
          <span class="font-mono text-base font-bold text-indigo-400">PTW</span>
        </div>
      </div>
      <div>
        <span class="block font-bold tracking-tight text-white group-hover:text-indigo-400 transition-colors">Praveen Mishra</span>
        <span class="block text-[11px] font-medium text-emerald-400 tracking-wider uppercase">Services & Portfolio</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-gray-300">
      <a href="#services" class="hover:text-indigo-400 transition-colors">Services</a>
      <a href="#case-studies" class="hover:text-indigo-400 transition-colors">Case Studies</a>
      <a href="#calculator" class="hover:text-indigo-400 transition-colors">Retainer Calculator</a>
      <a href="#portfolio" class="hover:text-indigo-400 transition-colors">Experience</a>
      <a href="https://www.praveentechworld.com/blog" target="_blank" class="text-xs font-mono text-emerald-400 hover:underline flex items-center gap-1">
        Tech Blog ↗
      </a>
    </nav>

    <!-- CTAs & Theme Toggle -->
    <div class="flex items-center gap-3">
      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle Light and Dark Mode"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-gray-700/80 bg-gray-900/80 text-amber-400 hover:bg-gray-800 hover:border-indigo-500 transition-all cursor-pointer"
      >
        <span id="theme-toggle-icon-dark" class="text-base">🌙</span>
        <span id="theme-toggle-icon-light" class="hidden text-base">☀️</span>
      </button>

      <a href="mailto:MishratWork@gmail.com" class="hidden sm:inline-flex items-center justify-center rounded-xl bg-gray-800/80 px-4 py-2 text-xs font-semibold text-gray-200 border border-gray-700/60 hover:bg-gray-700 hover:text-white transition-all">
        ✉️ Contact
      </a>
      <a href="#contact" class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-indigo-600 to-cyan-500 px-4 py-2 text-xs font-bold text-white shadow-lg shadow-indigo-600/30 hover:opacity-95 hover:scale-[1.02] active:scale-[0.98] transition-all">
        🚀 Hire Praveen
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('theme-toggle-btn');
    const darkIcon = document.getElementById('theme-toggle-icon-dark');
    const lightIcon = document.getElementById('theme-toggle-icon-light');

    function updateIcons() {
      const isLight = document.documentElement.classList.contains('light');
      if (isLight) {
        if (darkIcon) darkIcon.classList.add('hidden');
        if (lightIcon) lightIcon.classList.remove('hidden');
      } else {
        if (darkIcon) darkIcon.classList.remove('hidden');
        if (lightIcon) lightIcon.classList.add('hidden');
      }
    }

    updateIcons();

    if (btn) {
      btn.addEventListener('click', () => {
        const isLight = document.documentElement.classList.toggle('light');
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
        updateIcons();
      });
    }
  });
</script>
