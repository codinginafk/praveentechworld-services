---
---

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
  <canvas id="mercury-canvas" class="w-full h-full opacity-65 dark:opacity-45"></canvas>
</div>

<script>
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('mercury-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = parent.clientWidth;
    let height = parent.clientHeight;

    // Detect mobile / tablet screen size
    const isMobile = window.innerWidth < 768;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, width / height, 1, 1000);
    camera.position.set(0, 110, 220);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. Mobile-Optimized Soothing 3D Particle Grid
    const numX = isMobile ? 45 : 65;
    const numZ = isMobile ? 45 : 65;
    const numParticles = numX * numZ;

    const positions = new Float32Array(numParticles * 3);

    const separation = isMobile ? 10 : 8.5;
    let i = 0;

    for (let ix = 0; ix < numX; ix++) {
      for (let iz = 0; iz < numZ; iz++) {
        positions[i] = ix * separation - (numX * separation) / 2; // x
        positions[i + 1] = 0;                                       // y
        positions[i + 2] = iz * separation - (numZ * separation) / 2; // z
        i += 3;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    // Color adaptation for Light/Dark modes
    const isDark = document.documentElement.classList.contains('dark');
    const particleColor = isDark ? 0x818cf8 : 0x4f46e5;

    // Soft, Dreamy Micro-Dots (Soothing Ambient Glow)
    const material = new THREE.PointsMaterial({
      color: particleColor,
      size: isMobile ? 1.6 : 1.4,
      transparent: true,
      opacity: 0.45,
      blending: THREE.AdditiveBlending,
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // 3. Desktop Mouse & Mobile/Tablet Touch Interaction
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    function handleInput(clientX: number, clientY: number) {
      mouseX = (clientX - window.innerWidth / 2) * 0.08;
      mouseY = (clientY - window.innerHeight / 2) * 0.08;
    }

    document.addEventListener('mousemove', (e) => {
      handleInput(e.clientX, e.clientY);
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        handleInput(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    // Window Resize Handler
    window.addEventListener('resize', () => {
      if (!parent) return;
      width = parent.clientWidth;
      height = parent.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });

    // 4. Ultra-Soothing Slow Wave Animation Loop
    let count = 0;

    function animate() {
      requestAnimationFrame(animate);

      // Smooth camera interpolation
      targetX += (mouseX - targetX) * 0.03;
      targetY += (-mouseY - targetY) * 0.03;

      camera.position.x = targetX * 1.2;
      camera.position.y = 110 + targetY * 1.1;
      camera.lookAt(0, 0, 0);

      // Gentle, Silky 3D Wave Motion
      const positions = particles.geometry.attributes.position.array as Float32Array;

      let i = 0;
      for (let ix = 0; ix < numX; ix++) {
        for (let iz = 0; iz < numZ; iz++) {
          // Slow, gentle breathing sine wave (Math.sin + Math.cos)
          positions[i + 1] = (Math.sin((ix + count) * 0.15) * 9) + (Math.cos((iz + count) * 0.15) * 9);
          i += 3;
        }
      }

      particles.geometry.attributes.position.needsUpdate = true;
      particles.rotation.y = count * 0.02; // Slow soothing spin

      count += 0.025; // Gentle breathing rate (Reduced from 0.08)

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
