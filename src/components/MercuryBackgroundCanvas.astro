---
---

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
  <canvas id="mercury-canvas" class="w-full h-full opacity-80 dark:opacity-60"></canvas>
</div>

<script>
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('mercury-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = parent.clientWidth;
    let height = parent.clientHeight;
    const isMobile = window.innerWidth < 768;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, width / height, 1, 1000);
    camera.position.set(0, 120, 240);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. High-Density Fuller Dual-Layer 3D Particle System
    const numX = isMobile ? 60 : 90;
    const numZ = isMobile ? 60 : 90;
    const numParticles = numX * numZ;

    const positions = new Float32Array(numParticles * 3);
    const initialY = new Float32Array(numParticles);

    const separation = isMobile ? 9 : 7.5;
    let i = 0;

    for (let ix = 0; ix < numX; ix++) {
      for (let iz = 0; iz < numZ; iz++) {
        const x = ix * separation - (numX * separation) / 2;
        const z = iz * separation - (numZ * separation) / 2;
        positions[i] = x;
        positions[i + 1] = 0;
        positions[i + 2] = z;
        initialY[ix * numZ + iz] = 0;
        i += 3;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    const isDark = document.documentElement.classList.contains('dark');
    const particleColor = isDark ? 0xa5b4fc : 0x4f46e5;

    const material = new THREE.PointsMaterial({
      color: particleColor,
      size: isMobile ? 1.8 : 1.6,
      transparent: true,
      opacity: 0.55,
      blending: THREE.AdditiveBlending,
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // Ambient Floating Star Dust Layer (Fuller 3D Depth)
    const starCount = isMobile ? 150 : 350;
    const starPositions = new Float32Array(starCount * 3);
    for (let k = 0; k < starCount * 3; k += 3) {
      starPositions[k] = (Math.random() - 0.5) * 600;
      starPositions[k + 1] = (Math.random() - 0.5) * 300;
      starPositions[k + 2] = (Math.random() - 0.5) * 600;
    }
    const starGeometry = new THREE.BufferGeometry();
    starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const starMaterial = new THREE.PointsMaterial({
      color: isDark ? 0x38bdf8 : 0x0284c7,
      size: 2.2,
      transparent: true,
      opacity: 0.4,
      blending: THREE.AdditiveBlending,
    });
    const stars = new THREE.Points(starGeometry, starMaterial);
    scene.add(stars);

    // 3. Interactive Cursor Magnetic Ripples & Click Shockwaves
    let mouseWorld = new THREE.Vector3(0, 0, 0);
    let targetCameraX = 0;
    let targetCameraY = 0;

    const shockwaves: { x: number; z: number; radius: number; maxRadius: number; strength: number }[] = [];

    // Raycaster for exact 3D cursor intersection
    const raycaster = new THREE.Raycaster();
    const mousePlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
    const mouseVec = new THREE.Vector2(-100, -100);

    function updateMousePosition(clientX: number, clientY: number) {
      mouseVec.x = (clientX / window.innerWidth) * 2 - 1;
      mouseVec.y = -(clientY / window.innerHeight) * 2 + 1;

      raycaster.setFromCamera(mouseVec, camera);
      raycaster.ray.intersectPlane(mousePlane, mouseWorld);

      targetCameraX = mouseVec.x * 25;
      targetCameraY = mouseVec.y * 15;
    }

    document.addEventListener('mousemove', (e) => {
      updateMousePosition(e.clientX, e.clientY);
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        updateMousePosition(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    // Click Shockwave Trigger
    document.addEventListener('click', (e) => {
       shockwaves.push({
        x: mouseWorld.x,
        z: mouseWorld.z,
        radius: 0,
        maxRadius: 180,
        strength: 24,
      });
    }, { passive: true });

    // Window Resize
    window.addEventListener('resize', () => {
      if (!parent) return;
      width = parent.clientWidth;
      height = parent.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });

    // 4. Animation & Interactive Physics Loop
    let count = 0;

    function animate() {
      requestAnimationFrame(animate);

      // Smooth Camera Inertia
      camera.position.x += (targetCameraX - camera.position.x) * 0.04;
      camera.position.y += (120 + targetCameraY - camera.position.y) * 0.04;
      camera.lookAt(0, 0, 0);

      // Update Shockwaves
      for (let s = shockwaves.length - 1; s >= 0; s--) {
        const sw = shockwaves[s];
        sw.radius += 3.5;
        sw.strength *= 0.96;
        if (sw.radius > sw.maxRadius || sw.strength < 0.1) {
          shockwaves.splice(s, 1);
        }
      }

      // Interactive 3D Particle Displacement Calculation
      const posAttr = particles.geometry.attributes.position;
      const posArray = posAttr.array as Float32Array;

      let idx = 0;
      for (let ix = 0; ix < numX; ix++) {
        for (let iz = 0; iz < numZ; iz++) {
          const px = posArray[idx];
          const pz = posArray[idx + 2];

          // Base soothing breathing wave
          let y = (Math.sin((ix + count) * 0.14) * 10) + (Math.cos((iz + count) * 0.14) * 10);

          // Magnetic Cursor Push/Pull Force (3D Interactive Distortion)
          const dx = px - mouseWorld.x;
          const dz = pz - mouseWorld.z;
          const distSq = dx * dx + dz * dz;

          if (distSq < 12000) {
            const dist = Math.sqrt(distSq);
            const force = (1 - dist / 110);
            y += Math.sin(dist * 0.15 - count * 4) * 18 * force;
          }

          // Click Shockwave Propagation
          for (let s = 0; s < shockwaves.length; s++) {
            const sw = shockwaves[s];
            const sdx = px - sw.x;
            const sdz = pz - sw.z;
            const sdist = Math.sqrt(sdx * sdx + sdz * sdz);
            const waveDist = Math.abs(sdist - sw.radius);

            if (waveDist < 25) {
              const waveForce = (1 - waveDist / 25) * sw.strength;
              y += Math.sin(waveDist * 0.3) * waveForce;
            }
          }

          posArray[idx + 1] = y;
          idx += 3;
        }
      }

      posAttr.needsUpdate = true;
      stars.rotation.y = count * 0.01;
      particles.rotation.y = count * 0.015;

      count += 0.03;

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
