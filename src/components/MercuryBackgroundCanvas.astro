---
---

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
  <canvas id="mercury-canvas" class="w-full h-full opacity-75 dark:opacity-55"></canvas>
</div>

<script>
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('mercury-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = parent.clientWidth;
    let height = parent.clientHeight;
    const isMobile = window.innerWidth < 768;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, width / height, 1, 1000);
    camera.position.set(0, 110, 220);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. High-Density Particle Wave Grid (Aligned to Site Palette)
    const numX = isMobile ? 55 : 80;
    const numZ = isMobile ? 55 : 80;
    const numParticles = numX * numZ;

    const positions = new Float32Array(numParticles * 3);
    const separation = isMobile ? 9.5 : 8;
    let i = 0;

    for (let ix = 0; ix < numX; ix++) {
      for (let iz = 0; iz < numZ; iz++) {
        positions[i] = ix * separation - (numX * separation) / 2;
        positions[i + 1] = 0;
        positions[i + 2] = iz * separation - (numZ * separation) / 2;
        i += 3;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    // Theme Color Synchronization (Matches site font gradient: Indigo -> Cyan -> Emerald)
    function getThemeColors() {
      const isDark = document.documentElement.classList.contains('dark');
      return {
        primary: isDark ? 0x818cf8 : 0x4f46e5, // Indigo
        secondary: isDark ? 0x38bdf8 : 0x0284c7, // Cyan
        accent: isDark ? 0x34d399 : 0x059669, // Emerald
      };
    }

    let colors = getThemeColors();

    const material = new THREE.PointsMaterial({
      color: colors.primary,
      size: isMobile ? 1.7 : 1.5,
      transparent: true,
      opacity: 0.55,
      blending: THREE.AdditiveBlending,
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // Floating Ambient Dust Particles
    const starCount = isMobile ? 120 : 250;
    const starPositions = new Float32Array(starCount * 3);
    for (let k = 0; k < starCount * 3; k += 3) {
      starPositions[k] = (Math.random() - 0.5) * 550;
      starPositions[k + 1] = (Math.random() - 0.5) * 250;
      starPositions[k + 2] = (Math.random() - 0.5) * 550;
    }
    const starGeometry = new THREE.BufferGeometry();
    starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const starMaterial = new THREE.PointsMaterial({
      color: colors.secondary,
      size: 2.0,
      transparent: true,
      opacity: 0.4,
      blending: THREE.AdditiveBlending,
    });
    const stars = new THREE.Points(starGeometry, starMaterial);
    scene.add(stars);

    // 3. Perfect 100% Accurate Cursor Raycasting using getBoundingClientRect()
    const raycaster = new THREE.Raycaster();
    const mousePlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
    const mouseWorld = new THREE.Vector3(0, -999, 0);
    const mouseVec = new THREE.Vector2(-100, -100);

    function updateCursorRaycast(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      
      // Check if cursor is over or near canvas section
      if (
        clientX < rect.left - 100 ||
        clientX > rect.right + 100 ||
        clientY < rect.top - 100 ||
        clientY > rect.bottom + 100
      ) {
        mouseWorld.set(0, -999, 0);
        return;
      }

      mouseVec.x = ((clientX - rect.left) / rect.width) * 2 - 1;
      mouseVec.y = -((clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouseVec, camera);
      raycaster.ray.intersectPlane(mousePlane, mouseWorld);
    }

    document.addEventListener('mousemove', (e) => {
      updateCursorRaycast(e.clientX, e.clientY);
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        updateCursorRaycast(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    // Click Shockwave System
    const shockwaves: { x: number; z: number; radius: number; strength: number }[] = [];

    document.addEventListener('click', () => {
      if (mouseWorld.y !== -999) {
        shockwaves.push({
          x: mouseWorld.x,
          z: mouseWorld.z,
          radius: 0,
          strength: 22,
        });
      }
    }, { passive: true });

    // Window Resize & Scroll Handlers
    window.addEventListener('resize', () => {
      if (!parent) return;
      width = parent.clientWidth;
      height = parent.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });

    // Theme Toggle Color Watcher
    const observer = new MutationObserver(() => {
      colors = getThemeColors();
      material.color.setHex(colors.primary);
      starMaterial.color.setHex(colors.secondary);
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // 4. Smooth Animation Loop
    let count = 0;

    function animate() {
      requestAnimationFrame(animate);

      // Shockwave Propagation
      for (let s = shockwaves.length - 1; s >= 0; s--) {
        const sw = shockwaves[s];
        sw.radius += 3.8;
        sw.strength *= 0.95;
        if (sw.radius > 160 || sw.strength < 0.1) {
          shockwaves.splice(s, 1);
        }
      }

      // Deform Grid Positions
      const posAttr = particles.geometry.attributes.position;
      const posArray = posAttr.array as Float32Array;

      let idx = 0;
      for (let ix = 0; ix < numX; ix++) {
        for (let iz = 0; iz < numZ; iz++) {
          const px = posArray[idx];
          const pz = posArray[idx + 2];

          // Soothing breathing wave
          let y = (Math.sin((ix + count) * 0.14) * 8.5) + (Math.cos((iz + count) * 0.14) * 8.5);

          // Direct Cursor Magnetic Displacement
          if (mouseWorld.y !== -999) {
            const dx = px - mouseWorld.x;
            const dz = pz - mouseWorld.z;
            const distSq = dx * dx + dz * dz;

            if (distSq < 9000) {
              const dist = Math.sqrt(distSq);
              const force = (1 - dist / 95);
              y += Math.sin(dist * 0.18 - count * 3) * 16 * force;
            }
          }

          // Click Shockwave
          for (let s = 0; s < shockwaves.length; s++) {
            const sw = shockwaves[s];
            const sdx = px - sw.x;
            const sdz = pz - sw.z;
            const sdist = Math.sqrt(sdx * sdx + sdz * sdz);
            const waveDist = Math.abs(sdist - sw.radius);

            if (waveDist < 20) {
              const waveForce = (1 - waveDist / 20) * sw.strength;
              y += Math.sin(waveDist * 0.3) * waveForce;
            }
          }

          posArray[idx + 1] = y;
          idx += 3;
        }
      }

      posAttr.needsUpdate = true;
      stars.rotation.y = count * 0.008;
      particles.rotation.y = count * 0.012;

      count += 0.028;

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
