---
---

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
  <canvas id="mercury-canvas" class="w-full h-full opacity-70 dark:opacity-50"></canvas>
</div>

<script>
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('mercury-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = parent.clientWidth;
    let height = parent.clientHeight;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, width / height, 1, 1000);
    camera.position.set(0, 140, 260);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. Mercury Command Inspired 3D Particle Wave Grid
    const numX = 75;
    const numZ = 75;
    const numParticles = numX * numZ;

    const positions = new Float32Array(numParticles * 3);
    const scales = new Float32Array(numParticles);

    const separation = 8;
    let i = 0, j = 0;

    for (let ix = 0; ix < numX; ix++) {
      for (let iz = 0; iz < numZ; iz++) {
        positions[i] = ix * separation - (numX * separation) / 2; // x
        positions[i + 1] = 0;                                       // y
        positions[i + 2] = iz * separation - (numZ * separation) / 2; // z

        scales[j] = 1;

        i += 3;
        j++;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    // Color adaptation for Light/Dark modes
    const isDark = document.documentElement.classList.contains('dark');
    const particleColor = isDark ? 0x818cf8 : 0x4f46e5;

    const material = new THREE.PointsMaterial({
      color: particleColor,
      size: 2.2,
      transparent: true,
      opacity: 0.65,
      blending: THREE.AdditiveBlending,
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // 3. Interactive Mouse Distortion & Tilt
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    document.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX - window.innerWidth / 2) * 0.15;
      mouseY = (e.clientY - window.innerHeight / 2) * 0.15;
    }, { passive: true });

    // Resize Handler
    window.addEventListener('resize', () => {
      if (!parent) return;
      width = parent.clientWidth;
      height = parent.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });

    // 4. Animation Wave Loop
    let count = 0;

    function animate() {
      requestAnimationFrame(animate);

      // Smooth camera interpolation following mouse
      targetX += (mouseX - targetX) * 0.05;
      targetY += (-mouseY - targetY) * 0.05;

      camera.position.x = targetX * 1.5;
      camera.position.y = 140 + targetY * 1.2;
      camera.lookAt(0, 0, 0);

      // 3D Sine Wave Particle Displacement
      const positions = particles.geometry.attributes.position.array as Float32Array;

      let i = 0;
      for (let ix = 0; ix < numX; ix++) {
        for (let iz = 0; iz < numZ; iz++) {
          positions[i + 1] = (Math.sin((ix + count) * 0.25) * 18) + (Math.sin((iz + count) * 0.4) * 18);
          i += 3;
        }
      }

      particles.geometry.attributes.position.needsUpdate = true;
      particles.rotation.y = count * 0.05;

      count += 0.08;

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
