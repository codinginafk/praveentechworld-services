---
---

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0 w-full h-full">
  <canvas id="mercury-canvas" class="w-full h-full block opacity-85 dark:opacity-65"></canvas>
</div>

<script>
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('mercury-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = parent.clientWidth || window.innerWidth;
    let height = parent.clientHeight || window.innerHeight;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(65, width / height, 0.1, 1000);
    
    // Adjust camera distance to span 100% full screen top-to-bottom
    camera.position.set(0, 110, 200);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. High-Density Particle Wave Grid (Full Screen Coverage)
    const numX = 90;
    const numZ = 90;
    const numParticles = numX * numZ;

    const positions = new Float32Array(numParticles * 3);
    const separation = 8.5;
    let i = 0;

    for (let ix = 0; ix < numX; ix++) {
      for (let iz = 0; iz < numZ; iz++) {
        positions[i] = ix * separation - (numX * separation) / 2;     // x
        positions[i + 1] = 0;                                         // y
        positions[i + 2] = iz * separation - (numZ * separation) / 2; // z
        i += 3;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    // Colors
    const isDark = document.documentElement.classList.contains('dark');
    const primaryColor = new THREE.Color(isDark ? '#818cf8' : '#4f46e5');

    // 3. GPU GLSL Shader Material for 60-120 FPS Silky Smooth Wave Motion
    const uniforms = {
      uTime: { value: 0 },
      uColor: { value: primaryColor },
      uMouse: { value: new THREE.Vector3(0, -999, 0) },
      uPixelRatio: { value: Math.min(window.devicePixelRatio, 2) },
    };

    const vertexShader = `
      uniform float uTime;
      uniform vec3 uMouse;
      uniform float uPixelRatio;
      
      varying float vElevation;

      void main() {
        vec3 pos = position;

        // Fluid GPU Sine Wave Displacement
        float elevation = sin(pos.x * 0.12 + uTime * 1.5) * 8.0 
                        + cos(pos.z * 0.12 + uTime * 1.5) * 8.0;

        // Interactive Mouse Magnetic Ripple Force
        if (uMouse.y > -900.0) {
          float dist = distance(pos.xz, uMouse.xz);
          if (dist < 90.0) {
            float force = (1.0 - dist / 90.0);
            elevation += sin(dist * 0.18 - uTime * 4.0) * 16.0 * force;
          }
        }

        pos.y += elevation;
        vElevation = elevation;

        vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
        gl_Position = projectionMatrix * mvPosition;

        // Scale point size by distance to camera
        gl_PointSize = (14.0 / -mvPosition.z) * uPixelRatio;
      }
    `;

    const fragmentShader = `
      uniform vec3 uColor;
      varying float vElevation;

      void main() {
        // Soft circular particle shape
        float dist = distance(gl_PointCoord, vec2(0.5));
        if (dist > 0.5) discard;

        float alpha = (1.0 - dist * 2.0) * 0.6;
        vec3 finalColor = uColor + vec3(vElevation * 0.015);

        gl_FragColor = vec4(finalColor, alpha);
      }
    `;

    const material = new THREE.ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // 4. Exact Screen Coverage & Raycasting
    const raycaster = new THREE.Raycaster();
    const mousePlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);

    function updateSize() {
      if (!parent) return;
      width = parent.clientWidth || window.innerWidth;
      height = parent.clientHeight || window.innerHeight;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();

      // Dynamic Camera Z adjustment so wave covers 100% of viewport
      camera.position.z = Math.max(180, 240 * (height / width));
      renderer.setSize(width, height);
    }

    updateSize();

    function updateCursor(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const mouseVec = new THREE.Vector2(
        ((clientX - rect.left) / rect.width) * 2 - 1,
        -((clientY - rect.top) / rect.height) * 2 + 1
      );

      raycaster.setFromCamera(mouseVec, camera);
      const hit = new THREE.Vector3();
      if (raycaster.ray.intersectPlane(mousePlane, hit)) {
        uniforms.uMouse.value.copy(hit);
      }
    }

    document.addEventListener('mousemove', (e) => {
      updateCursor(e.clientX, e.clientY);
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        updateCursor(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    window.addEventListener('resize', updateSize);

    // Theme Toggle Color Watcher
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      uniforms.uColor.value.set(isDark ? '#818cf8' : '#4f46e5');
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // 5. Silky Smooth GPU Animation Loop
    let clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);

      const elapsedTime = clock.getElapsedTime();
      uniforms.uTime.value = elapsedTime;

      particles.rotation.y = elapsedTime * 0.02;

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
