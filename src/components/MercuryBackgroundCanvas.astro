---
---

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0 w-full h-full min-h-[500px]">
  <canvas id="mercury-canvas" class="w-full h-full block opacity-90 dark:opacity-75"></canvas>
</div>

<script>
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('mercury-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = parent.offsetWidth || window.innerWidth;
    let height = parent.offsetHeight || window.innerHeight;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, width / height, 1, 1000);
    camera.position.set(0, 110, 220);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. High-Density Particle Wave Grid
    const isMobile = window.innerWidth < 768;
    const numX = isMobile ? 60 : 85;
    const numZ = isMobile ? 60 : 85;
    const numParticles = numX * numZ;

    const positions = new Float32Array(numParticles * 3);
    const separation = isMobile ? 9 : 8;
    let i = 0;

    for (let ix = 0; ix < numX; ix++) {
      for (let iz = 0; iz < numZ; iz++) {
        positions[i] = ix * separation - (numX * separation) / 2;
        positions[i + 1] = 0;
        positions[i + 2] = iz * separation - (numZ * separation) / 2;
        i += 3;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    // Colors matching font theme
    const isDark = document.documentElement.classList.contains('dark');
    const particleColor = isDark ? 0x818cf8 : 0x4f46e5;

    const material = new THREE.PointsMaterial({
      color: particleColor,
      size: isMobile ? 2.0 : 1.8,
      transparent: true,
      opacity: isDark ? 0.7 : 0.65,
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // Floating Ambient Dust Nodes
    const starCount = isMobile ? 150 : 300;
    const starPositions = new Float32Array(starCount * 3);
    for (let k = 0; k < starCount * 3; k += 3) {
      starPositions[k] = (Math.random() - 0.5) * 600;
      starPositions[k + 1] = (Math.random() - 0.5) * 300;
      starPositions[k + 2] = (Math.random() - 0.5) * 600;
    }
    const starGeometry = new THREE.BufferGeometry();
    starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const starMaterial = new THREE.PointsMaterial({
      color: isDark ? 0x38bdf8 : 0x0284c7,
      size: 2.2,
      transparent: true,
      opacity: 0.5,
    });
    const stars = new THREE.Points(starGeometry, starMaterial);
    scene.add(stars);

    // 3. Perfect Raycasting Cursor Interaction
    const raycaster = new THREE.Raycaster();
    const mousePlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
    const mouseWorld = new THREE.Vector3(0, -999, 0);

    function updateCursor(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const mouseVec = new THREE.Vector2(
        ((clientX - rect.left) / rect.width) * 2 - 1,
        -((clientY - rect.top) / rect.height) * 2 + 1
      );

      raycaster.setFromCamera(mouseVec, camera);
      raycaster.ray.intersectPlane(mousePlane, mouseWorld);
    }

    document.addEventListener('mousemove', (e) => {
      updateCursor(e.clientX, e.clientY);
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        updateCursor(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    // Resize Handler
    function updateSize() {
      if (!parent) return;
      width = parent.offsetWidth || window.innerWidth;
      height = parent.offsetHeight || window.innerHeight;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    }

    window.addEventListener('resize', updateSize);

    // Theme Toggle Color Watcher
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      material.color.setHex(isDark ? 0x818cf8 : 0x4f46e5);
      starMaterial.color.setHex(isDark ? 0x38bdf8 : 0x0284c7);
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // 4. Fluid 60 FPS Wave Physics Loop
    let count = 0;

    function animate() {
      requestAnimationFrame(animate);

      const posAttr = particles.geometry.attributes.position;
      const posArray = posAttr.array as Float32Array;

      let idx = 0;
      for (let ix = 0; ix < numX; ix++) {
        for (let iz = 0; iz < numZ; iz++) {
          const px = posArray[idx];
          const pz = posArray[idx + 2];

          // Soothing breathing wave
          let y = (Math.sin((ix + count) * 0.14) * 9.5) + (Math.cos((iz + count) * 0.14) * 9.5);

          // Direct Cursor Magnetic Distortion
          if (mouseWorld.y !== -999) {
            const dx = px - mouseWorld.x;
            const dz = pz - mouseWorld.z;
            const distSq = dx * dx + dz * dz;

            if (distSq < 10000) {
              const dist = Math.sqrt(distSq);
              const force = (1 - dist / 100);
              y += Math.sin(dist * 0.16 - count * 3) * 16 * force;
            }
          }

          posArray[idx + 1] = y;
          idx += 3;
        }
      }

      posAttr.needsUpdate = true;
      stars.rotation.y = count * 0.008;
      particles.rotation.y = count * 0.012;

      count += 0.03;

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
