---
---

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0 w-full h-full min-h-[550px]">
  <canvas id="mercury-canvas" class="w-full h-full block opacity-95 dark:opacity-80"></canvas>
</div>

<script>
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('mercury-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = parent.offsetWidth || window.innerWidth;
    let height = parent.offsetHeight || window.innerHeight;

    const isMobile = window.innerWidth < 768;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, width / height, 1, 1000);
    camera.position.set(0, 115, 230);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. High-Density Particle Wave Grid with Dynamic Vertex Colors (ChaseAI Palette)
    const numX = isMobile ? 65 : 90;
    const numZ = isMobile ? 65 : 90;
    const numParticles = numX * numZ;

    const positions = new Float32Array(numParticles * 3);
    const colors = new Float32Array(numParticles * 3);
    const separation = isMobile ? 9 : 8;

    // ChaseAI Palette RGBs
    const colorViolet = new THREE.Color('#8b5cf6'); // Electric Violet
    const colorCyan = new THREE.Color('#06b6d4');   // Cyber Cyan
    const colorMagenta = new THREE.Color('#ec4899'); // Hot Magenta

    let i = 0;

    for (let ix = 0; ix < numX; ix++) {
      for (let iz = 0; iz < numZ; iz++) {
        // Position
        positions[i] = ix * separation - (numX * separation) / 2;
        positions[i + 1] = 0;
        positions[i + 2] = iz * separation - (numZ * separation) / 2;

        // Gradient Color Blend
        const ratio = (ix / numX + iz / numZ) * 0.5;
        let c = new THREE.Color();
        if (ratio < 0.5) {
          c.copy(colorViolet).lerp(colorCyan, ratio * 2);
        } else {
          c.copy(colorCyan).lerp(colorMagenta, (ratio - 0.5) * 2);
        }

        colors[i] = c.r;
        colors[i + 1] = c.g;
        colors[i + 2] = c.b;

        i += 3;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const material = new THREE.PointsMaterial({
      vertexColors: true,
      size: isMobile ? 2.2 : 2.0,
      transparent: true,
      opacity: 0.85,
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // Floating Ambient Dust Nodes (Cyan & Magenta Stars)
    const starCount = isMobile ? 180 : 350;
    const starPositions = new Float32Array(starCount * 3);
    const starColors = new Float32Array(starCount * 3);

    for (let k = 0; k < starCount * 3; k += 3) {
      starPositions[k] = (Math.random() - 0.5) * 650;
      starPositions[k + 1] = (Math.random() - 0.5) * 350;
      starPositions[k + 2] = (Math.random() - 0.5) * 650;

      const sc = Math.random() > 0.5 ? colorCyan : colorMagenta;
      starColors[k] = sc.r;
      starColors[k + 1] = sc.g;
      starColors[k + 2] = sc.b;
    }

    const starGeometry = new THREE.BufferGeometry();
    starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    starGeometry.setAttribute('color', new THREE.BufferAttribute(starColors, 3));

    const starMaterial = new THREE.PointsMaterial({
      vertexColors: true,
      size: 2.5,
      transparent: true,
      opacity: 0.6,
    });

    const stars = new THREE.Points(starGeometry, starMaterial);
    scene.add(stars);

    // 3. Perfect Raycasting Cursor Interaction
    const raycaster = new THREE.Raycaster();
    const mousePlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
    const mouseWorld = new THREE.Vector3(0, -999, 0);

    function updateCursor(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const mouseVec = new THREE.Vector2(
        ((clientX - rect.left) / rect.width) * 2 - 1,
        -((clientY - rect.top) / rect.height) * 2 + 1
      );

      raycaster.setFromCamera(mouseVec, camera);
      raycaster.ray.intersectPlane(mousePlane, mouseWorld);
    }

    document.addEventListener('mousemove', (e) => {
      updateCursor(e.clientX, e.clientY);
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        updateCursor(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    // Resize Handler
    function updateSize() {
      if (!parent) return;
      width = parent.offsetWidth || window.innerWidth;
      height = parent.offsetHeight || window.innerHeight;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    }

    window.addEventListener('resize', updateSize);

    // 4. Fluid 60 FPS Wave Physics Loop
    let count = 0;

    function animate() {
      requestAnimationFrame(animate);

      const posAttr = particles.geometry.attributes.position;
      const posArray = posAttr.array as Float32Array;

      let idx = 0;
      for (let ix = 0; ix < numX; ix++) {
        for (let iz = 0; iz < numZ; iz++) {
          const px = posArray[idx];
          const pz = posArray[idx + 2];

          // Soothing breathing wave
          let y = (Math.sin((ix + count) * 0.14) * 10) + (Math.cos((iz + count) * 0.14) * 10);

          // Direct Cursor Magnetic Distortion
          if (mouseWorld.y !== -999) {
            const dx = px - mouseWorld.x;
            const dz = pz - mouseWorld.z;
            const distSq = dx * dx + dz * dz;

            if (distSq < 11000) {
              const dist = Math.sqrt(distSq);
              const force = (1 - dist / 105);
              y += Math.sin(dist * 0.16 - count * 3) * 18 * force;
            }
          }

          posArray[idx + 1] = y;
          idx += 3;
        }
      }

      posAttr.needsUpdate = true;
      stars.rotation.y = count * 0.008;
      particles.rotation.y = count * 0.012;

      count += 0.03;

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
