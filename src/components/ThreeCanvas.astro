---
---

<div class="relative w-full h-[360px] sm:h-[420px] flex items-center justify-center overflow-hidden rounded-3xl glass-card spotlight-card border-beam my-12">
  <canvas id="three-canvas" class="w-full h-full cursor-grab active:cursor-grabbing"></canvas>
  
  <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between px-4 py-2 rounded-2xl bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border border-slate-200 dark:border-gray-800 text-xs font-semibold text-slate-700 dark:text-gray-300 pointer-events-none">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-indigo-500"></span>
      </span>
      <span>🎮 Interactive Three.js 3D WebGL Canvas</span>
    </div>
    <span class="font-mono text-[11px] text-indigo-600 dark:text-indigo-400 font-bold">Drag to Rotate 3D Geometry</span>
  </div>
</div>

<script>
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('three-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = parent.clientWidth;
    let height = parent.clientHeight;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 7;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. 3D TorusKnot Wireframe Geometry
    const isDark = document.documentElement.classList.contains('dark');
    const primaryColor = isDark ? 0x818cf8 : 0x4f46e5;
    const secondaryColor = isDark ? 0x38bdf8 : 0x0284c7;

    const geometry = new THREE.TorusKnotGeometry(1.6, 0.45, 128, 32);
    
    // Wireframe Material
    const wireframeMaterial = new THREE.MeshBasicMaterial({
      color: primaryColor,
      wireframe: true,
      transparent: true,
      opacity: 0.35,
    });

    const torusKnot = new THREE.Mesh(geometry, wireframeMaterial);
    scene.add(torusKnot);

    // Inner Glowing Nodes (Particles)
    const pointsGeometry = new THREE.TorusKnotGeometry(1.6, 0.45, 160, 40);
    const pointsMaterial = new THREE.PointsMaterial({
      color: secondaryColor,
      size: 0.04,
      transparent: true,
      opacity: 0.85,
    });
    const torusPoints = new THREE.Points(pointsGeometry, pointsMaterial);
    scene.add(torusPoints);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
    scene.add(ambientLight);

    const pointLight = new THREE.PointLight(0x4f46e5, 2, 50);
    pointLight.position.set(5, 5, 5);
    scene.add(pointLight);

    // Mouse Drag Interaction
    let isDragging = false;
    let previousMousePosition = { x: 0, y: 0 };
    let targetRotationX = 0;
    let targetRotationY = 0;

    canvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    canvas.addEventListener('mousemove', (e) => {
      if (!isDragging) {
        const rect = canvas.getBoundingClientRect();
        const x = (e.clientX - rect.left) / width - 0.5;
        const y = (e.clientY - rect.top) / height - 0.5;
        targetRotationY = x * 1.5;
        targetRotationX = y * 1.5;
        return;
      }

      const deltaX = e.clientX - previousMousePosition.x;
      const deltaY = e.clientY - previousMousePosition.y;

      torusKnot.rotation.y += deltaX * 0.01;
      torusKnot.rotation.x += deltaY * 0.01;
      torusPoints.rotation.y += deltaX * 0.01;
      torusPoints.rotation.x += deltaY * 0.01;

      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    // Window Resize Handler
    window.addEventListener('resize', () => {
      if (!parent) return;
      width = parent.clientWidth;
      height = parent.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });

    // Render Animation Loop
    function animate() {
      requestAnimationFrame(animate);

      if (!isDragging) {
        torusKnot.rotation.y += 0.005;
        torusKnot.rotation.x += 0.003;
        torusPoints.rotation.y += 0.005;
        torusPoints.rotation.x += 0.003;

        // Smooth spring interpolation
        torusKnot.rotation.y += (targetRotationY - torusKnot.rotation.y) * 0.05;
        torusKnot.rotation.x += (targetRotationX - torusKnot.rotation.x) * 0.05;
        torusPoints.rotation.y += (targetRotationY - torusPoints.rotation.y) * 0.05;
        torusPoints.rotation.x += (targetRotationX - torusPoints.rotation.x) * 0.05;
      }

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
