---
---

<section id="interactive-demo" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-slate-100/70 dark:bg-gray-950/60">
  <div class="mx-auto max-w-5xl space-y-12">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-50 dark:bg-indigo-500/10 px-4 py-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300 shadow-sm">
        ⚡ Inspira Animated Tabs Workspace
      </span>
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Explore Interactive <span class="gradient-text">Work Deliverables</span>
      </h2>
      <p class="text-base text-slate-600 dark:text-gray-400 leading-relaxed font-medium">
        Click any category below to see exact workflows, sample output, and before/after technical transformations.
      </p>
    </div>

    <!-- Animated Tab Navigation -->
    <div class="flex flex-wrap items-center justify-center gap-2 p-1.5 rounded-2xl bg-white dark:bg-gray-900 border border-slate-200 dark:border-gray-800 shadow-sm max-w-3xl mx-auto">
      <button data-tab="tab-video" class="tab-btn active px-4 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer bg-indigo-600 text-white shadow-md">
        🎬 Video Edits
      </button>
      <button data-tab="tab-ads" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer text-slate-700 dark:text-gray-300 hover:text-indigo-600">
        🎯 Paid Ads
      </button>
      <button data-tab="tab-ecom" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer text-slate-700 dark:text-gray-300 hover:text-indigo-600">
        🛒 E-Com Catalog Sync
      </button>
      <button data-tab="tab-ai" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer text-slate-700 dark:text-gray-300 hover:text-indigo-600">
        🤖 AI Python Scripts
      </button>
      <button data-tab="tab-web" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer text-slate-700 dark:text-gray-300 hover:text-indigo-600">
        ⚡ Fast Web Apps
      </button>
    </div>

    <!-- Tab Content Panes -->
    <div class="relative">

      <!-- Pane 1: Video Edits -->
      <div id="tab-video" class="tab-pane glass-card spotlight-card border-beam rounded-3xl p-8 space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400 uppercase">CapCut & Premiere Pro Work</span>
            <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">Short Reel Cuts & Video Ad Edits</h3>
          </div>
          <span class="rounded-full bg-indigo-50 dark:bg-indigo-500/10 px-3 py-1 text-xs font-bold text-indigo-700 dark:text-indigo-300">
            🎬 High-Engagement Social Cuts
          </span>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📱</span> Short-Form CapCut Reels
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              Fast-paced cuts, kinetic caption styling, sound design, and hook pacing optimized for TikTok, Instagram Reels, and YouTube Shorts algorithms.
            </p>
            <ul class="space-y-1.5 text-xs text-slate-700 dark:text-gray-300 font-medium">
              <li class="flex items-center gap-2">✓ Animated Subtitles & Highlight Colors</li>
              <li class="flex items-center gap-2">✓ Background Music & SFX Mix</li>
              <li class="flex items-center gap-2">✓ 9:16 Vertical Export Optimized for Mobile</li>
            </ul>
          </div>

          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🖥️</span> Premiere Pro Ad Campaigns
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              Polished horizontal and square ad creatives for Meta, YouTube, and website landing pages with custom lower-thirds, title graphics, and color grading.
            </p>
            <ul class="space-y-1.5 text-xs text-slate-700 dark:text-gray-300 font-medium">
              <li class="flex items-center gap-2">✓ Multi-Cam Editing & Audio Cleaning</li>
              <li class="flex items-center gap-2">✓ Motion Title Graphics & Product B-Roll</li>
              <li class="flex items-center gap-2">✓ High-Bitrate Pro Exports for Paid Ads</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Pane 2: Paid Ads -->
      <div id="tab-ads" class="tab-pane hidden glass-card spotlight-card border-beam rounded-3xl p-8 space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono font-bold text-cyan-600 dark:text-cyan-400 uppercase">Google & Meta Performance</span>
            <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">Campaign Setup & Conversion Tracking</h3>
          </div>
          <span class="rounded-full bg-cyan-50 dark:bg-cyan-500/10 px-3 py-1 text-xs font-bold text-cyan-700 dark:text-cyan-300">
            🎯 Full Conversion Setup
          </span>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🔍</span> Google Ads (Search & PMax)
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              Negative keyword lists, tight ad groups, ad copy writing, responsive search ads, and Performance Max asset group building.
            </p>
          </div>

          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📊</span> Meta Pixel & Event Setup
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              Custom conversions (`Purchase`, `AddToCart`, `Lead`), CAPI server-side event tracking, and custom audience retargeting setup.
            </p>
          </div>
        </div>
      </div>

      <!-- Pane 3: E-Com Catalog Sync -->
      <div id="tab-ecom" class="tab-pane hidden glass-card spotlight-card border-beam rounded-3xl p-8 space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400 uppercase">Shopify, Magento & Marketplace Ops</span>
            <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">Live Catalog Sync (Noon & Carrefour)</h3>
          </div>
          <span class="rounded-full bg-amber-50 dark:bg-amber-500/10 px-3 py-1 text-xs font-bold text-amber-700 dark:text-amber-300">
            🛒 Retail Store Sync
          </span>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📦</span> Marketplace Sync (Noon / Carrefour)
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              Updating product titles, barcodes, stock levels, and promotional discounts in real-time across Noon, Carrefour, ElGrocer, and InstaShop.
            </p>
          </div>

          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🏷️</span> Storefront Banner & Price Launches
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              Launching promo banners, configuring multi-buy discount rules, and troubleshooting checkout flow glitches on live web stores.
            </p>
          </div>
        </div>
      </div>

      <!-- Pane 4: AI Scripts -->
      <div id="tab-ai" class="tab-pane hidden glass-card spotlight-card border-beam rounded-3xl p-8 space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 uppercase">Python & Local LLM Automation</span>
            <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">Custom Spreadsheet & Log Processing Scripts</h3>
          </div>
          <span class="rounded-full bg-emerald-50 dark:bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-700 dark:text-emerald-300">
            🤖 Offline AI Pipelines
          </span>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🐍</span> Python Data Automation
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              Cleaning thousands of messy CSV/Excel rows, deduplicating records, merging product catalogs, and generating automated PDF/text reports.
            </p>
          </div>

          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🧠</span> DeepSeek & Ollama Pipelines
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              Running open-weight AI models locally to parse server logs and analyze documents completely offline with zero API fees.
            </p>
          </div>
        </div>
      </div>

      <!-- Pane 5: Fast Web Apps -->
      <div id="tab-web" class="tab-pane hidden glass-card spotlight-card border-beam rounded-3xl p-8 space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400 uppercase">Astro & Next.js Builds</span>
            <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">Sub-Second Edge Web Architecture</h3>
          </div>
          <span class="rounded-full bg-blue-50 dark:bg-blue-500/10 px-3 py-1 text-xs font-bold text-blue-700 dark:text-blue-300">
            ⚡ 100/100 Lighthouse
          </span>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>⚡</span> Fast Static & Edge Deployments
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              High-converting landing pages and static web apps built with Astro and Tailwind that score 100/100 performance on Google PageSpeed Insights.
            </p>
          </div>

          <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 border border-slate-200 dark:border-gray-800 space-y-3">
            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📡</span> IndexNow & Technical SEO
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed">
              Automated IndexNow protocol pings, OpenGraph tags, GSC sitemap submissions, and custom GA4 analytics dashboards.
            </p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        // Reset all buttons
        tabBtns.forEach((b) => {
          b.classList.remove('bg-indigo-600', 'text-white', 'shadow-md');
          b.classList.add('text-slate-700', 'dark:text-gray-300');
        });

        // Activate clicked button
        btn.classList.add('bg-indigo-600', 'text-white', 'shadow-md');
        btn.classList.remove('text-slate-700', 'dark:text-gray-300');

        // Hide all panes
        tabPanes.forEach((pane) => pane.classList.add('hidden'));

        // Show target pane
        const activePane = document.getElementById(targetTab);
        if (activePane) {
          activePane.classList.remove('hidden');
        }
      });
    });
  });
</script>
