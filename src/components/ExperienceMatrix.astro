---
const experienceTimeline = [
  {
    role: "Digital Marketing Executive & E-Commerce Lead",
    company: "Adil Supermarket E-Commerce (35+ Retail Branches)",
    location: "Dubai & Ajman, UAE",
    period: "Full-Time & Key Execution",
    highlights: [
      "Executed Google Ads (Performance Max, Search) & Meta Ads for high-volume retail e-commerce.",
      "Managed live Magento & Shopify store platforms (adilstore.com & bh.adilstore.com).",
      "Synchronized daily catalog listings, promo rules, and stock sync across Noon, Carrefour, ElGrocer, and InstaShop.",
      "Built custom Power BI dashboards translating sales and campaign data into executive reports."
    ],
    skillsSold: ["Paid Ads Management", "Marketplace Catalog Sync", "E-Commerce Web Ops", "Power BI Dashboards"]
  },
  {
    role: "Founder & E-Commerce Web Architect",
    company: "NatureNestGifts (NatureNestGifts.vercel.app)",
    location: "Independent Venture",
    period: "End-to-End Build",
    highlights: [
      "Architected an independent e-commerce storefront for handcrafted candles from scratch.",
      "Designed UI layouts, product ad banners, graphics mockups, and customer acquisition campaigns."
    ],
    skillsSold: ["Custom E-Commerce Builds", "Brand Identity & Design", "Social Media Ads"]
  },
  {
    role: "AI & Technical Systems Engineer",
    company: "PraveenTechWorld (praveentechworld.com)",
    location: "Knowledge Base & Tooling Hub",
    period: "Active Publisher",
    highlights: [
      "Built 90+ technical guides reaching 389 static HTML pages with sub-second search.",
      "Engineered automated IndexNow broadcast triggers, GA4 tracking, and Python LLM scripts."
    ],
    skillsSold: ["AI Workflow Automation", "GA4 & Technical SEO", "IndexNow Setup"]
  }
];

const credentials = {
  education: [
    { degree: "B.Tech in Computer Science Engineering", institution: "Guru Tegh Bahadur Institute of Technology, Delhi", score: "Grade A (2019 – 2022)" },
    { degree: "Diploma in Computer Science", institution: "Delhi Skill & Entrepreneurship University, Delhi", score: "Grade A (2016 – 2019)" }
  ],
  certifications: [
    { name: "Databases for Developers Foundations", org: "Oracle Dev Gym (2025)" },
    { name: "Computer Hardware Basics", org: "Cisco (2025)" },
    { name: "Introduction to SQL", org: "DataCamp (2023)" },
    { name: "Complete Web Developer Course", org: "Udemy (2021)" }
  ]
};
---

<section id="portfolio" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-gray-950/40">
  <div class="mx-auto max-w-7xl">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-1.5 text-xs font-bold text-amber-300">
        🎓 Professional Background & Selling Competencies
      </span>
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        Work History & <span class="gradient-text">Monetizable Expertise</span>
      </h2>
      <p class="text-base text-gray-400 leading-relaxed">
        Proven track record combining Computer Science engineering with full-funnel digital marketing across top UAE retail networks and independent ventures.
      </p>
    </div>

    <!-- Timeline Grid -->
    <div class="space-y-8 mb-20">
      {experienceTimeline.map((exp) => (
        <div class="glass-card spotlight-card rounded-3xl p-8 border border-gray-800">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div>
              <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider">{exp.period}</span>
              <h3 class="text-2xl font-extrabold text-white mt-1">{exp.role}</h3>
              <div class="text-sm font-semibold text-indigo-400 mt-0.5">🏢 {exp.company} • <span class="text-gray-400">{exp.location}</span></div>
            </div>
            
            <div class="flex flex-wrap gap-2">
              {exp.skillsSold.map((s) => (
                <span class="rounded-full bg-indigo-500/10 border border-indigo-500/30 px-3 py-1 text-xs font-bold text-indigo-300">
                  ⚡ {s}
                </span>
              ))}
            </div>
          </div>

          <ul class="space-y-2.5 mb-6">
            {exp.highlights.map((h) => (
              <li class="flex items-start gap-3 text-sm text-gray-300 leading-relaxed">
                <span class="text-emerald-400 mt-1">✓</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Education & Certifications Side-by-Side -->
    <div class="grid gap-8 md:grid-cols-2">
      <!-- Education -->
      <div class="glass-card rounded-3xl p-8 border border-gray-800">
        <h3 class="text-xl font-extrabold text-white mb-6 flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-400 text-xl">🎓</span>
          Education & Engineering Degree
        </h3>
        <div class="space-y-4">
          {credentials.education.map((edu) => (
            <div class="rounded-2xl bg-gray-900/80 p-5 border border-gray-800/80">
              <span class="text-xs font-mono font-bold text-emerald-400">{edu.score}</span>
              <h4 class="text-base font-bold text-white mt-1">{edu.degree}</h4>
              <p class="text-xs text-gray-400 mt-1">{edu.institution}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Certifications -->
      <div class="glass-card rounded-3xl p-8 border border-gray-800">
        <h3 class="text-xl font-extrabold text-white mb-6 flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 text-xl">📜</span>
          Verified Certifications & Credentials
        </h3>
        <div class="space-y-3">
          {credentials.certifications.map((c) => (
            <div class="flex items-center justify-between rounded-xl bg-gray-900/80 p-4 border border-gray-800/80">
              <div>
                <h4 class="text-sm font-bold text-white">{c.name}</h4>
                <p class="text-xs text-gray-400 mt-0.5">{c.org}</p>
              </div>
              <span class="text-xs font-mono font-bold text-indigo-400 bg-indigo-500/10 px-2.5 py-1 rounded-lg border border-indigo-500/20">Verified</span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
