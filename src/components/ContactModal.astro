---
---

<section id="contact" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-gray-950/60">
  <div class="mx-auto max-w-5xl">
    
    <div class="glass-card rounded-3xl p-8 sm:p-12 border border-gray-800 relative overflow-hidden">
      <!-- Glow effect -->
      <div class="ambient-glow -bottom-24 -right-24 h-80 w-80 bg-indigo-500/20"></div>

      <div class="grid gap-12 lg:grid-cols-12 relative z-10 items-center">
        
        <!-- Info Column -->
        <div class="space-y-6 lg:col-span-5">
          <span class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-1.5 text-xs font-bold text-indigo-300">
            ✉️ Get in Touch
          </span>
          
          <h2 class="text-3xl font-extrabold text-white sm:text-4xl">
            Let’s Build & Scale Your <span class="gradient-text">Growth Engine</span>
          </h2>

          <p class="text-sm text-gray-300 leading-relaxed">
            Available for immediate full-time roles, strategic retainers, or technical AI/E-Commerce growth projects across the UAE (Dubai, Ajman) and globally.
          </p>

          <div class="space-y-3 pt-2 text-sm font-medium">
            <div class="flex items-center gap-3 text-gray-200">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-800 text-indigo-400">📧</span>
              <div>
                <div class="text-[11px] text-gray-400 font-mono">Direct Email</div>
                <a href="mailto:MishratWork@gmail.com" class="font-bold text-white hover:text-indigo-400 transition-colors">MishratWork@gmail.com</a>
              </div>
            </div>

            <div class="flex items-center gap-3 text-gray-200">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-800 text-emerald-400">📍</span>
              <div>
                <div class="text-[11px] text-gray-400 font-mono">Location & Visa</div>
                <div class="font-bold text-white">Dubai, UAE (Valid Residence Visa)</div>
              </div>
            </div>

            <div class="flex items-center gap-3 text-gray-200">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-800 text-cyan-400">💼</span>
              <div>
                <div class="text-[11px] text-gray-400 font-mono">LinkedIn</div>
                <a href="https://www.linkedin.com/in/praveen-kumar-says/" target="_blank" class="font-bold text-white hover:text-cyan-400 transition-colors">linkedin.com/in/praveen-kumar-says</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Column -->
        <div class="lg:col-span-7">
          <form action="https://formspree.io/f/xbjnqkyv" method="POST" class="space-y-4 rounded-2xl bg-gray-900/80 p-6 sm:p-8 border border-gray-800">
            <div>
              <label class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-2">Your Name</label>
              <input type="text" name="name" required placeholder="John Doe" class="w-full rounded-xl bg-gray-950 px-4 py-3 text-sm text-white border border-gray-800 focus:border-indigo-500 focus:outline-none transition-colors" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-2">Email Address</label>
                <input type="email" name="email" required placeholder="john@company.com" class="w-full rounded-xl bg-gray-950 px-4 py-3 text-sm text-white border border-gray-800 focus:border-indigo-500 focus:outline-none transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-2">Service Needed</label>
                <select name="service" class="w-full rounded-xl bg-gray-950 px-4 py-3 text-sm text-white border border-gray-800 focus:border-indigo-500 focus:outline-none transition-colors">
                  <option>Paid Performance Ads (Google & Meta)</option>
                  <option>AI Automation & Python Scripts</option>
                  <option>E-Commerce Catalog Operations</option>
                  <option>SEO/SEM & GA4 Analytics</option>
                  <option>Full-Time Role Discussion</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-2">Project Details / Message</label>
              <textarea name="message" rows="4" required placeholder="Tell me about your brand goals, target timeline, or project scope..." class="w-full rounded-xl bg-gray-950 px-4 py-3 text-sm text-white border border-gray-800 focus:border-indigo-500 focus:outline-none transition-colors"></textarea>
            </div>

            <button type="submit" class="w-full rounded-xl bg-gradient-to-r from-indigo-600 via-cyan-500 to-emerald-400 p-3.5 text-sm font-bold text-white shadow-lg shadow-indigo-600/30 hover:opacity-95 hover:scale-[1.01] active:scale-[0.99] transition-all">
              Send Strategy Inquiry 🚀
            </button>
          </form>
        </div>

      </div>
    </div>

  </div>
</section>
