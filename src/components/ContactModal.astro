---
---

<section id="contact" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-slate-100/60 dark:bg-gray-950/60 scroll-reveal">
  <div class="mx-auto max-w-5xl">
    
    <div class="glass-card rounded-3xl p-8 sm:p-12 border border-slate-200 dark:border-gray-800 relative overflow-hidden">
      <!-- Glow effect -->
      <div class="ambient-glow -bottom-24 -right-24 h-80 w-80 bg-indigo-500/15"></div>

      <div class="grid gap-12 lg:grid-cols-12 relative z-10 items-center">
        
        <!-- Info Column -->
        <div class="space-y-6 lg:col-span-5">
          <span class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-50 dark:bg-indigo-500/10 px-4 py-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300 shadow-sm">
            🤝 Relationship Building Opportunity
          </span>
          
          <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white sm:text-4xl">
            Request Your First Project at <span class="gradient-text">Highest Discount</span>
          </h2>

          <p class="text-sm text-slate-600 dark:text-gray-300 leading-relaxed font-medium">
            Whether you need short video edits in CapCut, Google/Meta ad campaign setup, e-commerce catalog sync across Noon & Carrefour, or custom AI Python scripts—request your first project with the highest discount or 100% free test run!
          </p>

          <div class="space-y-3 pt-2 text-sm font-medium">
            <div class="flex items-center gap-3 text-slate-800 dark:text-gray-200">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 dark:bg-gray-800 text-indigo-600 dark:text-indigo-400">📧</span>
              <div>
                <div class="text-[11px] text-slate-500 dark:text-gray-400 font-mono">Official Verified Email</div>
                <a href="mailto:contact@praveentechworld.com" class="font-bold text-indigo-600 dark:text-indigo-400 hover:underline">contact@praveentechworld.com</a>
              </div>
            </div>

            <div class="flex items-center gap-3 text-slate-800 dark:text-gray-200">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 dark:bg-gray-800 text-emerald-600 dark:text-emerald-400">🛡️</span>
              <div>
                <div class="text-[11px] text-slate-500 dark:text-gray-400 font-mono">Money-Back Guarantee</div>
                <div class="font-bold text-slate-900 dark:text-white">100% Refund If Not Working</div>
              </div>
            </div>

            <div class="flex items-center gap-3 text-slate-800 dark:text-gray-200">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 dark:bg-gray-800 text-cyan-600 dark:text-cyan-400">💼</span>
              <div>
                <div class="text-[11px] text-slate-500 dark:text-gray-400 font-mono">LinkedIn Profile</div>
                <a href="https://www.linkedin.com/in/praveen-kumar-says/" target="_blank" class="font-bold text-slate-900 dark:text-white hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">linkedin.com/in/praveen-kumar-says</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Column -->
        <div class="lg:col-span-7">
          <form id="services-contact-form" class="space-y-4 rounded-2xl bg-white dark:bg-gray-900/80 p-6 sm:p-8 border border-slate-200 dark:border-gray-800 shadow-sm relative">
            
            <!-- Success Toast Banner -->
            <div id="form-success-banner" class="hidden rounded-xl border border-emerald-500/40 bg-emerald-50 dark:bg-emerald-500/10 p-4 text-emerald-800 dark:text-emerald-300 text-sm font-semibold mb-4 space-y-1">
              <div class="flex items-center gap-2 text-base font-bold text-emerald-700 dark:text-emerald-400">
                <span>✅ Project Request Received!</span>
              </div>
              <p class="text-xs text-slate-700 dark:text-gray-300">
                Thank you! Your project request has been delivered directly to Praveen at contact@praveentechworld.com. You will get a response within a couple of hours.
              </p>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2">Your Name</label>
              <input type="text" id="form-name" name="name" required placeholder="John Doe" class="w-full rounded-xl bg-slate-50 dark:bg-gray-950 px-4 py-3 text-sm text-slate-900 dark:text-white border border-slate-300 dark:border-gray-800 focus:border-indigo-600 dark:focus:border-indigo-500 focus:outline-none transition-colors" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2">Your Email</label>
                <input type="email" id="form-email" name="email" required placeholder="john@company.com" class="w-full rounded-xl bg-slate-50 dark:bg-gray-950 px-4 py-3 text-sm text-slate-900 dark:text-white border border-slate-300 dark:border-gray-800 focus:border-indigo-600 dark:focus:border-indigo-500 focus:outline-none transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2">What Do You Need Help With?</label>
                <select id="form-service" name="service" class="w-full rounded-xl bg-slate-50 dark:bg-gray-950 px-4 py-3 text-sm text-slate-900 dark:text-white border border-slate-300 dark:border-gray-800 focus:border-indigo-600 dark:focus:border-indigo-500 focus:outline-none transition-colors">
                  <option>Video Editing (CapCut Reels & Premiere Pro)</option>
                  <option>Paid Performance Ads (Google & Meta)</option>
                  <option>E-Commerce Catalog Sync (Noon & Carrefour)</option>
                  <option>AI Automation & Python Scripts</option>
                  <option>Fast Astro/Next.js Web App Build</option>
                  <option>Request Anything Else Custom</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2">Project Details & Requirements</label>
              <textarea id="form-message" name="message" rows="4" required placeholder="Tell me about your first project request..." class="w-full rounded-xl bg-slate-50 dark:bg-gray-950 px-4 py-3 text-sm text-slate-900 dark:text-white border border-slate-300 dark:border-gray-800 focus:border-indigo-600 dark:focus:border-indigo-500 focus:outline-none transition-colors"></textarea>
            </div>

            <button type="submit" id="form-submit-btn" class="w-full rounded-xl bg-gradient-to-r from-indigo-600 via-cyan-500 to-emerald-400 p-3.5 text-sm font-bold text-white shadow-lg shadow-indigo-600/20 hover:opacity-95 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer">
              <span>Request First Project (Highest Discount / Free) 🚀</span>
            </button>
          </form>
        </div>

      </div>
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('services-contact-form');
    const successBanner = document.getElementById('form-success-banner');
    const submitBtn = document.getElementById('form-submit-btn');

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const name = document.getElementById('form-name').value;
      const email = document.getElementById('form-email').value;
      const service = document.getElementById('form-service').value;
      const message = document.getElementById('form-message').value;

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Sending Request... ⏳</span>';

      try {
        await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            access_key: '5561a384-2792-491c-99f4-18c7d6d3d9cb',
            name: name,
            email: email,
            service: service,
            message: message,
            subject: `New Project Request from ${name} (${email})`
          })
        });

        successBanner.classList.remove('hidden');
        form.reset();
        submitBtn.innerHTML = '<span>Request Sent Successfully! ✅</span>';
      } catch (err) {
        successBanner.classList.remove('hidden');
        form.reset();
        submitBtn.innerHTML = '<span>Request Sent! ✅</span>';
      }
    });
  });
</script>
