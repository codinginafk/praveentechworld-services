---
---

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0 w-full h-full min-h-[550px]">
  <canvas id="matrix-canvas" class="w-full h-full block opacity-85 dark:opacity-75"></canvas>
</div>

<script>
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('matrix-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = parent.offsetWidth || window.innerWidth;
    let height = parent.offsetHeight || window.innerHeight;
    const isMobile = window.innerWidth < 768;

    // 1. Scene & Camera Setup
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, width / height, 1, 1000);
    camera.position.set(0, 0, 300);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. Slow & Dynamic 3D Matrix Falling Code Streams
    const streamCount = isMobile ? 70 : 150;
    const particlesPerStream = isMobile ? 12 : 18;
    const totalParticles = streamCount * particlesPerStream;

    const positions = new Float32Array(totalParticles * 3);
    const baseSpeeds = new Float32Array(totalParticles);
    const baseX = new Float32Array(totalParticles);
    const streamIds = new Float32Array(totalParticles);

    let idx = 0;
    for (let s = 0; s < streamCount; s++) {
      const streamX = (Math.random() - 0.5) * 700;
      const streamZ = (Math.random() - 0.5) * 400;
      // SLOW HYPNOTIC CADENCE: 0.3 to 0.8 speed
      const streamSpeed = 0.3 + Math.random() * 0.5;

      for (let p = 0; p < particlesPerStream; p++) {
        const y = 320 + p * 20 + Math.random() * 40;
        positions[idx * 3] = streamX;
        positions[idx * 3 + 1] = y;
        positions[idx * 3 + 2] = streamZ;

        baseX[idx] = streamX;
        baseSpeeds[idx] = streamSpeed;
        streamIds[idx] = s;

        idx++;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    // Colors: Matrix Cyber Emerald & Cyber Cyan
    const isDark = document.documentElement.classList.contains('dark');
    const matrixColor = isDark ? 0x34d399 : 0x059669;

    const material = new THREE.PointsMaterial({
      color: matrixColor,
      size: isMobile ? 2.6 : 2.2,
      transparent: true,
      opacity: 0.75,
      blending: THREE.AdditiveBlending,
    });

    const matrixRain = new THREE.Points(geometry, material);
    scene.add(matrixRain);

    // Ambient Cyber Stars
    const starCount = isMobile ? 100 : 200;
    const starPositions = new Float32Array(starCount * 3);
    for (let k = 0; k < starCount * 3; k += 3) {
      starPositions[k] = (Math.random() - 0.5) * 800;
      starPositions[k + 1] = (Math.random() - 0.5) * 600;
      starPositions[k + 2] = (Math.random() - 0.5) * 400;
    }
    const starGeometry = new THREE.BufferGeometry();
    starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const starMaterial = new THREE.PointsMaterial({
      color: isDark ? 0x38bdf8 : 0x0284c7,
      size: 1.8,
      transparent: true,
      opacity: 0.4,
    });
    const stars = new THREE.Points(starGeometry, starMaterial);
    scene.add(stars);

    // 3. Dynamic Cursor Position & Interactive Raycasting
    const raycaster = new THREE.Raycaster();
    const mousePlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
    const mouseWorld = new THREE.Vector3(0, -999, 0);

    let mouseX = 0;
    let mouseY = 0;

    function updateCursor(clientX: number, clientY: number) {
      const rect = canvas.getBoundingClientRect();
      const mouseVec = new THREE.Vector2(
        ((clientX - rect.left) / rect.width) * 2 - 1,
        -((clientY - rect.top) / rect.height) * 2 + 1
      );

      mouseX = mouseVec.x * 20;
      mouseY = mouseVec.y * 15;

      raycaster.setFromCamera(mouseVec, camera);
      raycaster.ray.intersectPlane(mousePlane, mouseWorld);
    }

    document.addEventListener('mousemove', (e) => {
      updateCursor(e.clientX, e.clientY);
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        updateCursor(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    // Resize Handler
    function updateSize() {
      if (!parent) return;
      width = parent.offsetWidth || window.innerWidth;
      height = parent.offsetHeight || window.innerHeight;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    }

    window.addEventListener('resize', updateSize);

    // Theme Toggle Color Watcher
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      material.color.setHex(isDark ? 0x34d399 : 0x059669);
      starMaterial.color.setHex(isDark ? 0x38bdf8 : 0x0284c7);
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // 4. Dynamic & Slow 3D Matrix Falling Loop with Sway & Cursor Boost
    let time = 0;

    function animate() {
      requestAnimationFrame(animate);
      time += 0.02;

      // Parallax Camera Follow
      camera.position.x += (mouseX - camera.position.x) * 0.03;
      camera.position.y += (-mouseY - camera.position.y) * 0.03;
      camera.lookAt(0, 0, 0);

      const posAttr = matrixRain.geometry.attributes.position;
      const posArray = posAttr.array as Float32Array;

      for (let p = 0; p < totalParticles; p++) {
        const xIdx = p * 3;
        const yIdx = p * 3 + 1;
        const zIdx = p * 3 + 2;

        const bx = baseX[p];
        const sId = streamIds[p];

        // Dynamic 3D Sine Wave Sway (Curved natural falling motion)
        posArray[xIdx] = bx + Math.sin(time * 1.2 + sId) * 8;

        // Dynamic Cursor Proximity Speed Boost
        let currentSpeed = baseSpeeds[p];
        if (mouseWorld.y !== -999) {
          const dx = posArray[xIdx] - mouseWorld.x;
          const dy = posArray[yIdx] - mouseWorld.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 80) {
            currentSpeed *= 2.2; // Accelerated dynamic speed near cursor!
          }
        }

        // Slow Falling Motion
        posArray[yIdx] -= currentSpeed;

        // Loop back to top smoothly
        if (posArray[yIdx] < -350) {
          posArray[yIdx] = 350 + Math.random() * 40;
        }
      }

      posAttr.needsUpdate = true;
      stars.rotation.z = time * 0.01;

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
