---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import MercuryBackgroundCanvas from "../components/MercuryBackgroundCanvas.astro";
import CustomCursor from "../components/CustomCursor.astro";
import InteractiveTabs from "../components/InteractiveTabs.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import IdeaToEnterpriseWorkflow from "../components/IdeaToEnterpriseWorkflow.astro";
import CaseStudies from "../components/CaseStudies.astro";
import ExperienceMatrix from "../components/ExperienceMatrix.astro";
import PricingCalculator from "../components/PricingCalculator.astro";
import ContactModal from "../components/ContactModal.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <CustomCursor />
  <Header />
  <main>
    <!-- Mercury Command Inspired 3D Particle Background Hero Section -->
    <div class="relative overflow-hidden">
      <MercuryBackgroundCanvas />
      <Hero />
    </div>

    <InteractiveTabs />
    <BeforeAfterSlider />
    <ServicesGrid />
    <IdeaToEnterpriseWorkflow />
    <CaseStudies />
    <ExperienceMatrix />
    <PricingCalculator />
    <ContactModal />
  </main>
  <Footer />
</BaseLayout>
