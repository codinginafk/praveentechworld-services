---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ThreeCanvas from "../components/ThreeCanvas.astro";
import ParticleCanvas from "../components/ParticleCanvas.astro";
import CustomCursor from "../components/CustomCursor.astro";
import InteractiveTabs from "../components/InteractiveTabs.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import CaseStudies from "../components/CaseStudies.astro";
import ExperienceMatrix from "../components/ExperienceMatrix.astro";
import PricingCalculator from "../components/PricingCalculator.astro";
import ContactModal from "../components/ContactModal.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <CustomCursor />
  <Header />
  <main>
    <div class="relative">
      <ParticleCanvas />
      <Hero />
    </div>
    
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 scroll-reveal">
      <ThreeCanvas />
    </div>

    <InteractiveTabs />
    <BeforeAfterSlider />
    <ServicesGrid />
    <CaseStudies />
    <ExperienceMatrix />
    <PricingCalculator />
    <ContactModal />
  </main>
  <Footer />
</BaseLayout>
